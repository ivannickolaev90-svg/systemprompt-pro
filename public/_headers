/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://mc.yandex.ru; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com; form-action 'self' https://yoomoney.ru https://*.yoomoney.ru; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/api/*
  Cache-Control: no-store

/covers/*
  Access-Control-Allow-Origin: *
